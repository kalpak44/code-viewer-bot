{
  "name": "code-viewer-bot",
  "displayName": "Code Viewer Bot",
  "description": "A configurable mouse-rotation bot for VS Code with scheduled idle automation.",
  "version": "0.0.1",
  "publisher": "kalpak44",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalpak44/code-viewer-bot.git"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "vscode": "^1.61.0"
  },
  "dependencies": {
    "robotjs": "^0.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "@vscode/vsce": "^3.7.1"
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "build:dev": "node esbuild.js",
    "postinstall": "node scripts/postinstall.js",
    "vscode:prepublish": "npm run build"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:extension.openConfig"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openConfig",
        "title": "Open Configuration",
        "category": "Code Viewer Bot"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.openConfig",
          "group": "navigation"
        }
      ],
      "menubar/view": [
        {
          "command": "extension.openConfig",
          "group": "9_code-viewer-bot"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.openConfig",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ]
  }
}
