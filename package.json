{
  "name": "code-viewer-bot",
  "displayName": "Code Viewer Bot",
  "description": "A configurable mouse-rotation bot for VS Code with scheduled idle automation.",
  "version": "0.0.1",
  "publisher": "kalpak44",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalpak44/code-viewer-bot.git"
  },
  "engines": {
    "vscode": "^1.61.0"
  },
  "dependencies": {
    "robotjs": "^0.7.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  },
  "scripts": {
    "postinstall": "echo \"Rebuilding native modules for robotjs...\" && npm rebuild robotjs || true"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:extension.openConfig"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openConfig",
        "title": "Open Bot Configuration"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.openConfig"
        }
      ]
    }
  }
}
