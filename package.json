{
  "name": "code-viewer-bot",
  "displayName": "Code Viewer Bot",
  "description": "A configurable idle automation bot for VS Code with mouse movement and workspace file browsing.",
  "version": "0.0.9",
  "publisher": "kalpakus",
  "pricing": "Free",
  "sponsor": {
    "url": "https://github.com/sponsors/kalpak44"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalpak44/code-viewer-bot.git"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "vscode": "^1.61.0"
  },
  "dependencies": {
    "robotjs": "^0.9.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8"
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "build:dev": "node esbuild.js",
    "postinstall": "node scripts/postinstall.js",
    "vscode:prepublish": "npm run build",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "automation",
    "idle",
    "workspace",
    "files",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codeViewerBot.openConfiguration"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeViewerBot.openConfiguration",
        "category": "Code Viewer Bot",
        "title": "Configure Bot"
      }
    ],
    "keybindings": [
      {
        "command": "codeViewerBot.openConfiguration",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ]
  }
}
